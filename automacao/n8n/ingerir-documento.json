    {
      "id": "a1000001-0000-4000-8000-000000000006",
      "name": "Existe resumo",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        960,
        0
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "=/data/docs/resumos/{{ $('Preparar arquivo').item.json.base }}.md",
        "options": {}
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "a1000001-0000-4000-8000-000000000007",
      "name": "Nome final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "// se já existe entrada/<nome> ou resumos/<base>.md, acrescenta -AAAAMMDD-HHMMSS aos dois (nunca sobrescreve)\nconst p = $('Preparar arquivo').first();\nconst existe = (no) => $(no).all().some(i => i.binary && Object.keys(i.binary).length > 0);\nlet { nome, base, ext } = p.json;\nif (existe('Existe original') || existe('Existe resumo')) {\n  const d = new Date(); const z = (x) => String(x).padStart(2, '0');\n  const sufixo = `-${d.getFullYear()}${z(d.getMonth()+1)}${z(d.getDate())}-${z(d.getHours())}${z(d.getMinutes())}${z(d.getSeconds())}`;\n  base = base + sufixo; nome = `${base}.${ext}`;\n  p.binary.data.fileName = nome;\n}\nreturn [{ json: { nome, base, ext }, binary: p.binary }];"
      }
    },
