    {
      "id": "a1000001-0000-4000-8000-000000000002",
      "name": "Preparar arquivo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "// nome seguro (sem caminho nem caracteres estranhos), binário sempre em \"data\" e extensão validada\nconst it = items[0];\nconst bins = it.binary || {};\nconst chave = Object.keys(bins)[0];\nif (!chave) throw new Error('Nenhum arquivo foi enviado.');\nconst b = bins[chave];\nconst original = b.fileName || 'documento.txt';\nconst seguro = original.replace(/^.*[\\\\/]/, '').replace(/[^\\p{L}\\p{N}._ -]/gu, '_');\nconst ponto = seguro.lastIndexOf('.');\nconst base = ponto > 0 ? seguro.slice(0, ponto) : seguro;\nconst ext = ponto > 0 ? seguro.slice(ponto + 1).toLowerCase() : '';\nb.fileName = seguro;\n// acceptFileTypes do formulário só vale no navegador; aqui é a validação de verdade\nconst valido = ['txt', 'md', 'pdf'].includes(ext);\nreturn [{ json: { nome: seguro, base, ext, valido }, binary: { data: b } }];"
      }
    },
    {
      "id": "a1000001-0000-4000-8000-000000000003",
      "name": "Extensão válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c3",
              "leftValue": "={{ $json.valido }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
