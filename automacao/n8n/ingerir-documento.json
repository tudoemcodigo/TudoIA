        "formDescription": "Envie um arquivo .txt, .md ou .pdf. Ele é salvo em docs/entrada, resumido e indexado no cérebro na hora.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Documento",
              "fieldType": "file",
              "acceptFileTypes": ".txt,.md,.pdf",
              "multipleFiles": false,
              "requiredField": true
            }
          ]
        },
        "responseMode": "responseNode",
