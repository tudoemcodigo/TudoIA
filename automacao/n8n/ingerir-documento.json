      "parameters": {
        "jsCode": "// limita o texto enviado ao modelo; o arquivo original continua inteiro em docs/entrada\nconst t = String($json.text ?? $json.data ?? '').trim();\nreturn [{ json: { vazio: !t, texto: t.slice(0, 30000), cortado: t.length > 30000 } }];"
      }
