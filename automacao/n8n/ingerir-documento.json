        3840,
        0
      ],
      "parameters": {
        "jsCode": "const nome = $('Nome final').item.json.nome;\nconst s = Number($json.statusCode);\nlet m;\nif (s === 200) m = 'indexação concluída.';\nelse if (s === 409) m = 'já havia uma indexação em andamento; o arquivo entra na próxima rodada.';\nelse m = `falha na indexação (HTTP ${s}); o resumo foi salvo.`;\nreturn [{ json: { mensagem: `Documento ingerido: ${nome}. ${m}\\n\\n${$('Montar resumo').item.json.resumo}` } }];"
      }
    },
