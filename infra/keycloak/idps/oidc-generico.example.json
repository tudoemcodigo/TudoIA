{
  "alias": "oidc-generico",
  "displayName": "Provedor OIDC",
  "providerId": "oidc",
  "enabled": true,
  "trustEmail": false,
  "storeToken": false,
  "linkOnly": false,
  "config": {
    "issuer": "${TUDOIA_IDP_OIDC_ISSUER}",
    "useJwksUrl": "true",
    "validateSignature": "true",
    "clientId": "${TUDOIA_IDP_OIDC_CLIENT_ID}",
    "clientSecret": "${TUDOIA_IDP_OIDC_CLIENT_SECRET}",
    "clientAuthMethod": "client_secret_post",
    "defaultScope": "openid profile email",
    "syncMode": "FORCE",
    "useUserInfo": "false"
  },
  "mappers": [
    {
      "name": "oidc-grupo-tudoia-admin",
      "identityProviderMapper": "oidc-advanced-group-idp-mapper",
      "config": {
        "claims": "[{\"key\":\"groups\",\"value\":\"${TUDOIA_IDP_OIDC_GRUPO_ADMIN}\"}]",
        "are.claim.values.regex": "false",
        "group": "/tudoia-admin"
      }
    }
  ]
}
