# ==============================================================================
# TudoIA - Configuracao unica (.env). Edite aqui ou pelo painel: http://127.0.0.1:3100
# Sem aspas e sem espacos em volta do "=". Chave vazia = provedor desligado.
# Nunca compartilhe este arquivo publicamente nem suba no git.
# ==============================================================================

# ═══════════ 1. SEGREDOS INTERNOS (`tudoia segredos` gera os vazios — não precisa digitar) ═══════════
WEBUI_SECRET_KEY=
SEARXNG_SECRET=
N8N_ENCRYPTION_KEY=
LITELLM_MASTER_KEY=
LITELLM_DB_PASSWORD=
# Token sem expiração dos clientes MCP locais para o Cérebro (papel de operador). Mín. 32 caracteres.
# Revogar: trocar o valor e reiniciar o serviço cerebro. Depois, `tudoia sync` para os clientes.
CEREBRO_TOKEN_ESTATICO=
TZ=

# ═══════════ 0. IDENTIDADE (login do painel via OpenID Connect) ═══════════
# Issuer do realm que autentica o painel. Padrão: Keycloak local com o realm `tudoia`
# (provisione com `tudoia keycloak provisionar`; veja docs/componentes/keycloak.md).
TUDOIA_OIDC_ISSUER=http://localhost:8180/realms/tudoia
TUDOIA_OIDC_CLIENT_ID=tudoia-painel
# Preenchido pelo `tudoia keycloak provisionar` (secret do client; nunca versionar).
TUDOIA_OIDC_CLIENT_SECRET=
TUDOIA_OIDC_SCOPE=openid email profile
# Chave que assina o cookie de sessão. Gerada automaticamente se vazia (mínimo 32 caracteres).
TUDOIA_SESSAO_SEGREDO=
# 1 = cookie só por HTTPS (use atrás de um proxy com TLS). 0 = local em http://127.0.0.1.
TUDOIA_COOKIE_SEGURO=0

# ═══════════ 0a. STACK DOCKER (o instalador preenche; edite se quiser outra combinação) ═══════════
# Quais serviços sobem, por perfil do compose: cerebro (Cérebro + SearXNG), webui (Open WebUI + Kokoro + SearXNG),
# n8n e keycloak (login embutido). litellm e o Postgres dele sempre sobem. Tire `keycloak` se usa um Keycloak seu.
COMPOSE_PROFILES=cerebro,webui,n8n,keycloak
# Nome do projeto compose (prefixo dos volumes). Outro nome isola esta instalação de uma que já exista na máquina.
TUDOIA_COMPOSE_PROJETO=tudoia
# Keycloak embutido: admin do realm master e senha do banco dele. As senhas vêm de `tudoia segredos` (não digite).
TUDOIA_KEYCLOAK_URL=http://localhost:8180
TUDOIA_KEYCLOAK_ADMIN=admin
TUDOIA_KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# ═══════════ 0b. CAMINHOS (deixe vazio para o padrão do repositório) ═══════════
# Pasta do ComfyUI portable (onde ficam run_*.bat e a pasta ComfyUI). Ex.: D:\IA\ComfyUI_windows_portable
TUDOIA_COMFYUI_PORTABLE=
# Pasta de pesos do Ollama (OLLAMA_MODELS). Ex.: D:\IA\ollama\models
TUDOIA_OLLAMA_MODELS=

# ═══════════ 2. LOCAL ═══════════
# Ollama visto de dentro dos containers (Open WebUI, LiteLLM, n8n).
OLLAMA_URL=
# Estúdio: 1 = quando ComfyUI e Cloudflare falham, gera a imagem no Pollinations (serviço público, sem conta, que
# recebe o prompt na URL). Vazio ou 0 = nunca envia o prompt para lá.
TUDOIA_ESTUDIO_POLLINATIONS=

# ═══════════ 3. FREE — nuvem gratuita (o roteador tudoia-auto usa estes) ═══════════
# Gratuito NÃO é privado: o texto sai da sua máquina. Limites mudam sem aviso; o painel mostra o uso.

# ── FREE · NVIDIA NIM · build.nvidia.com → Get API Key (nvapi-) · ~40 pedidos/min ──
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_BASE=

# ── FREE · OpenRouter (modelos :free) · openrouter.ai/keys (sk-or-) · 50 pedidos/dia, 20/min ──
OPENROUTER_API_KEY=

# ── FREE · Groq · console.groq.com/keys (gsk_) · ~1000 pedidos/dia por modelo, 30/min ──
GROQ_API_KEY=

# ── FREE · Google Gemini · aistudio.google.com/apikey · ⚠  o plano grátis usa seus dados para treino ──
GEMINI_API_KEY=

# ── FREE · Cloudflare Workers AI · dash.cloudflare.com → AI → Workers AI · 10.000 neurons/dia ──
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# ═══════════ 4. PAID — cobrados por uso; só usados quando você escolhe pelo nome (tudoia-max) ═══════════

# ── PAID · Anthropic (Claude) · console.anthropic.com → API Keys (sk-ant-) ──
ANTHROPIC_API_KEY=

# ── PAID · OpenAI (GPT) · platform.openai.com/api-keys (sk-) ──
OPENAI_API_KEY=

# ── PAID · DeepSeek · platform.deepseek.com/api_keys (sk-) · muito barato ──
DEEPSEEK_API_KEY=

# ── PAID · xAI (Grok) · console.x.ai (xai-) ──
XAI_API_KEY=

# ── PAID · Hugging Face Inference Providers · huggingface.co/settings/tokens (hf_) · precisa de créditos ──
HF_TOKEN=

# ═══════════ 5. EXPERIMENTAL — plano grátis não confirmado ou instável (descomente para testar) ═══════════
# SAMBANOVA_API_KEY=
# ZAI_API_KEY=


# Muapi / TudoEstudio (estúdio multimídia)
MUAPI_KEY=
MUAPI_API_KEY=

# --- governança (ex-TudoHaS) ---
CONTEXT7_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
